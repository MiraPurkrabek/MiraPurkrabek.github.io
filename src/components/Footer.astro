---
import Container from './Container.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <Container size="page"
    ><div class="footer-inner">
      <p>© {year} {site.preferredName}</p>
      <nav aria-label="Footer">
        <a href={site.cvPath}>CV (PDF)</a><a href="/news/">Archive</a><a
          href="/coaching/">Coaching</a
        ><a href={site.social.orcid}>ORCID</a><a href={`mailto:${site.email.university}`}>CTU email</a>
      </nav>
    </div></Container
  >
</footer>
<style>
  footer {
    padding-block: 1.5rem;
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.8125rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.15rem;
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
