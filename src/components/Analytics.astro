---
// GA4, async, production builds only, rendered after the page content so it can never block
// first paint. Skipped on /styleguide (internal reference, not real traffic). See
// docs/redesign_15-08-2026_PRs/PR-11-seo-metadata-redirects.md §7.
const MEASUREMENT_ID = 'G-1YMZGNY57C';
const isStyleguide = Astro.url.pathname.replace(/\/$/, '') === '/styleguide';
const shouldLoad = import.meta.env.PROD && !isStyleguide;
---

{
  shouldLoad && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}
      />
      <script is:inline define:vars={{ MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', MEASUREMENT_ID);
      </script>
    </>
  )
}
