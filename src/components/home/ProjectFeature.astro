---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const { data } = project;

const defaultLinkOrder = [
  ['project', 'Project'],
  ['paper', 'Paper'],
  ['code', 'Code'],
  ['demo', 'Demo'],
  ['models', 'Models'],
  ['dataset', 'Dataset'],
  ['grant', 'Grant'],
  ['article', 'Article'],
] as const;

const fallbackLabels = Object.fromEntries(defaultLinkOrder) as Record<
  (typeof defaultLinkOrder)[number][0],
  string
>;
const linkOrder =
  data.featuredLinkOrder ?? defaultLinkOrder.map(([key]) => key);
const links = linkOrder.flatMap((key) => {
  const href = data.links?.[key];
  return href
    ? [{ href, label: data.linkLabels?.[key] ?? fallbackLabels[key] }]
    : [];
});
const primaryHref = links[0]?.href;

const videoPreviews = {
  'bbox-mask-pose': {
    src: '/assets/videos/project-previews/bbox-mask-pose.mp4',
    poster: '/assets/img/project-previews/bbox-mask-pose.jpg',
  },
  probpose: {
    src: '/assets/videos/project-previews/probpose.mp4',
    poster: '/assets/img/project-previews/probpose.jpg',
  },
} as const;

const preview = videoPreviews[project.id as keyof typeof videoPreviews];
const metadata = data.featuredMeta ?? `${data.years} · ${data.role}`;
---

<article
  class:list={[
    'project-feature',
    {
      'project-feature--reverse': reverse,
      'project-feature--text-only': !data.image,
    },
  ]}
>
  <!-- The heading intentionally precedes the figure in DOM order. CSS places the figure above
       it on small screens, while screen readers encounter the project context first. -->
  <div class="project-feature__text">
    <p class="project-feature__meta">{metadata}</p>
    <h3 class="project-feature__title">
      {
        primaryHref ? (
          <a href={primaryHref} target="_blank" rel="noopener">
            {data.title}
            <Icon name="arrow-up-right" size={18} />
          </a>
        ) : (
          data.title
        )
      }
    </h3>
    <p class="project-feature__summary">{data.summary}</p>

    {
      links.length > 0 && (
        <nav class="project-feature__links" aria-label={`${data.title} links`}>
          {links.map(({ href, label }) => (
            <Button
              href={href}
              variant="ghost"
              size="sm"
              icon="arrow-up-right"
              target="_blank"
            >
              {label}
            </Button>
          ))}
        </nav>
      )
    }
  </div>

  {
    data.image && (
      <figure class="project-feature__media">
        {preview ? (
          <video
            class="project-feature__video"
            muted
            loop
            playsinline
            preload="none"
            poster={preview.poster}
            aria-label={data.image.alt}
            data-lazy-video
          >
            <source data-src={preview.src} type="video/mp4" />
          </video>
        ) : (
          <Image
            src={data.image.src}
            alt={data.image.alt}
            loading="lazy"
            decoding="async"
            class="project-feature__image"
          />
        )}
      </figure>
    )
  }
</article>

<script>
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;
  const videos = document.querySelectorAll('video[data-lazy-video]');

  const hydrateVideo = (video: HTMLVideoElement) => {
    if (video.dataset.lazyVideoHydrated) return;
    video.dataset.lazyVideoHydrated = 'true';

    const source = video.querySelector('source[data-src]');
    if (source instanceof HTMLSourceElement && source.dataset.src) {
      source.src = source.dataset.src;
      video.load();
      void video.play().catch(() => undefined);
    }
  };

  if (!prefersReducedMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const video = entry.target;
          if (video instanceof HTMLVideoElement) {
            hydrateVideo(video);
            observer.unobserve(video);
          }
        });
      },
      { rootMargin: '200px 0px' },
    );

    videos.forEach((video) => {
      if (video instanceof HTMLVideoElement) observer.observe(video);
    });
  } else if (!prefersReducedMotion) {
    videos.forEach((video) => {
      if (video instanceof HTMLVideoElement) hydrateVideo(video);
    });
  }
</script>

<style>
  .project-feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }

  .project-feature__text {
    grid-row: 2;
    max-width: 460px;
  }

  .project-feature__meta {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
  }

  .project-feature__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
  }

  .project-feature__title :global(a) {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--text);
    text-decoration: none;
  }

  .project-feature__title :global(a:hover) {
    color: var(--accent);
    text-decoration: underline;
  }

  .project-feature__title :global(svg) {
    flex: 0 0 auto;
  }

  .project-feature__summary {
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  .project-feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-5);
  }

  .project-feature__media {
    grid-row: 1;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .project-feature__media :global(img),
  .project-feature__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur) var(--ease);
  }

  .project-feature:hover .project-feature__media :global(img),
  .project-feature:hover .project-feature__video {
    transform: scale(1.02);
  }

  .project-feature--text-only .project-feature__text {
    grid-row: 1;
    max-width: 460px;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .project-feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    }

    .project-feature__text {
      grid-column: 2;
      grid-row: 1;
    }

    .project-feature__media {
      grid-column: 1;
    }

    .project-feature--reverse .project-feature__text {
      grid-column: 1;
    }

    .project-feature--reverse .project-feature__media {
      grid-column: 2;
    }

    .project-feature--text-only .project-feature__text {
      grid-column: 1 / -1;
      justify-self: end;
      width: 100%;
    }

    .project-feature--reverse.project-feature--text-only
      .project-feature__text {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-feature__media :global(img),
    .project-feature__video {
      transform: none;
    }
  }
</style>
