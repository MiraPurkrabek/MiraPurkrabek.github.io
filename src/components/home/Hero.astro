---
import { Picture } from 'astro:assets';
import Container from '../Container.astro';
import { site } from '../../data/site';
import portrait from '../../assets/img/SKV_square_centered.png';
---

<section class="intro">
  <Container size="page">
    <div class="intro__grid">
      <div>
        <p class="intro__role">Computer vision researcher &amp; engineer</p>
        <h1>{site.name}</h1>
        <p class="intro__lead">
          I work on understanding people and the world around them through
          images.
        </p>
        <p>
          I'm a PhD researcher at <a href="https://vrg.fel.cvut.cz/"
            >CTU Prague</a
          >, advised by <a href="https://cmp.felk.cvut.cz/~matas/">Jiří Matas</a
          >, and currently at <a href="https://www.qualcomm.com/"
            >Qualcomm XR Labs</a
          > in Amsterdam, working on 3D reconstruction. My research focuses on human
          pose, particularly when people overlap, leave the frame, or are seen from
          unusual angles.
        </p>
        <p class="intro__personal">
          I've also spent eight years <a href="/coaching/">coaching floorball</a
          >. Away from both, I like mountains and a good epic fantasy book.
        </p>
        <div class="intro__links" aria-label="Profile and contact links">
          <a href={`mailto:${site.email.primary}`}>Email</a>
          <a href={site.cvPath}>CV <span>(2 pages)</span></a>
          <a href={site.social.googleScholar}>Scholar</a>
          <a href={site.social.github}>GitHub</a>
          <a href={site.social.linkedin}>LinkedIn</a>
        </div>
      </div>
      <figure class="intro__portrait">
        <Picture
          src={portrait}
          alt="Mira Purkrábek"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={480}
          height={520}
          fit="cover"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>From Prague, currently in Amsterdam.</figcaption>
      </figure>
    </div>
    <div class="intro__proof" aria-label="Selected experience and achievements">
      <a href="/publications/"
        >First-author research at <strong>CVPR &amp; ICCV</strong></a
      >
      <a href="/work/#facis"
        >Forensic tools <strong>used by the Czech Police</strong></a
      >
      <a href="/work/#s23dr"><strong>1st place</strong> · S23DR, CVPR 2026</a>
    </div>
  </Container>
</section>
<style>
  .intro {
    padding-top: 2.5rem;
  }
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 3.5rem;
    align-items: start;
  }
  .intro__role {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  h1 {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    margin-bottom: 1rem;
  }
  .intro__lead {
    font-size: 1.1875rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    max-width: 45ch;
  }
  .intro__grid p:not(.intro__role):not(.intro__lead) {
    color: var(--text-muted);
  }
  .intro__personal {
    margin-top: 0.75rem;
  }
  .intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.15rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .intro__links a {
    text-decoration: none;
    padding-block: 0.25rem;
  }
  .intro__links a:hover {
    text-decoration: underline;
  }
  .intro__links span {
    color: var(--text-subtle);
    font-size: 0.875rem;
  }
  .intro__portrait {
    padding-top: 0.3rem;
  }
  .intro__portrait :global(img) {
    width: 100%;
    aspect-ratio: 12 / 13;
    object-fit: cover;
    border-radius: 6px;
  }
  figcaption {
    color: var(--text-subtle);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin-top: 0.65rem;
  }
  .intro__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
    padding-block: 1.5rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
  }
  .intro__proof a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .intro__proof a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .intro__proof strong {
    font-weight: 600;
    color: var(--text);
  }
  @media (max-width: 640px) {
    .intro {
      padding-top: 1.5rem;
    }
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) 100px;
      gap: 1rem;
    }
    .intro__grid > div {
      display: contents;
    }
    .intro__role,
    h1 {
      grid-column: 1;
    }
    h1 {
      font-size: 2rem;
      margin-bottom: 0.25rem;
    }
    .intro__role {
      align-self: end;
      margin: 0;
      font-size: 0.875rem;
    }
    .intro__portrait {
      grid-column: 2;
      grid-row: 1 / 3;
      padding: 0;
    }
    figcaption {
      display: none;
    }
    .intro__grid p:not(.intro__role),
    .intro__links {
      grid-column: 1 / -1;
      margin: 0;
    }
    .intro__proof {
      margin-top: 0.25rem;
    }
  }
</style>
