---
// Homepage hero — see docs/redesign_15-08-2026_PRs/PR-04-home-hero-impact.md §1 for the
// verbatim copy this component renders.
import { Picture } from 'astro:assets';
import Container from '../Container.astro';
import Button from '../Button.astro';
import { site } from '../../data/site';
import portraitLight from '../../assets/img/SKV_square_centered.png';
import portraitDark from '../../assets/img/SKV_square_centered_dark.png';
---

<section class="hero">
  <Container size="page">
    <div class="hero__grid">
      <div class="hero__text">
        {
          site.availability.show && (
            <p class="hero__pill">{site.availability.text}</p>
          )
        }

        <h1 class="hero__name">{site.name}</h1>
        <p class="hero__legal-name">({site.legalName})</p>

        <p class="hero__role">{site.role}</p>

        <p class="hero__lede">
          I build visual perception that survives contact with reality — crowded
          scenes, cropped bodies, unusual viewpoints. First-author papers at
          CVPR and ICCV, code and models people actually run, and systems that
          went into production.
        </p>

        <p class="hero__credentials">
          PhD candidate at CTU Prague · currently research intern at Qualcomm,
          Amsterdam
        </p>

        <p class="hero__keywords">
          Human understanding · 2D &amp; 3D vision · Robust perception
        </p>

        <div class="hero__actions">
          <Button href="#work" variant="primary" icon="arrow-right">
            Selected work
          </Button>
          <Button
            href={site.cvPath}
            target="_blank"
            variant="secondary"
            icon="download"
          >
            CV (PDF)
          </Button>
          <Button
            href={`mailto:${site.email.primary}`}
            variant="secondary"
            icon="mail"
            iconPosition="leading"
          >
            Email
          </Button>
        </div>
      </div>

      <div class="hero__portrait">
        <div class="hero__portrait-frame">
          <Picture
            src={portraitLight}
            alt={site.name}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={640}
            height={640}
            loading="eager"
            fetchpriority="high"
            class="hero__portrait-img hero__portrait-img--light"
          />
          <Picture
            src={portraitDark}
            alt=""
            aria-hidden="true"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={640}
            height={640}
            loading="eager"
            fetchpriority="high"
            class="hero__portrait-img hero__portrait-img--dark"
          />
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-top: var(--space-10);
    padding-bottom: var(--section-gap);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-5);
    padding: var(--space-2) var(--space-4);
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .hero__name {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-2);
  }

  .hero__legal-name {
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }

  .hero__role {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero__lede {
    max-width: 52ch;
    margin-bottom: var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .hero__credentials {
    margin-bottom: var(--space-5);
    color: var(--text-muted);
  }

  .hero__keywords {
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
  }

  .hero__portrait-frame {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1 / 1;
  }

  /* Two photos, one per theme (different shirt/backdrop shot for each) — swapped by opacity,
     not loaded conditionally, so the correct one is already in place at first paint (the
     data-theme attribute is set synchronously before the page renders; see BaseLayout). */
  .hero__portrait :global(.hero__portrait-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    transition: opacity var(--dur) var(--ease);
  }

  .hero__portrait :global(.hero__portrait-img--dark) {
    opacity: 0;
  }

  :root[data-theme='dark'] .hero__portrait :global(.hero__portrait-img--light) {
    opacity: 0;
  }

  :root[data-theme='dark'] .hero__portrait :global(.hero__portrait-img--dark) {
    opacity: 1;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-9);
    }

    .hero__portrait-frame {
      max-width: 100%;
    }
  }
</style>
