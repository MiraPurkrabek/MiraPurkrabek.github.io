---
import { getCollection } from 'astro:content';
import Container from '../Container.astro';
const experience = await getCollection('experience');
const affiliations = experience
  .filter((entry) => entry.data.inStrip && entry.data.homepage)
  .sort((a, b) => a.data.homepage!.order - b.data.homepage!.order);
---

<section aria-labelledby="experience-heading" class="affiliations">
  <Container size="page">
    <div class="affiliations__inner">
      <div class="affiliations__heading">
        <h2 id="experience-heading">Experience</h2>
        <a href="/cv/#experience">Full experience &amp; education</a>
      </div>
      <ul>
        {affiliations.map(({ id, data }) => (
          <li class:list={['affiliation', 'affiliation--' + id]}>
            <a class="affiliation-logo" href={data.orgUrl} aria-label={data.homepage!.name}>
              <img src={data.logo} alt={data.homepage!.logoAlt ?? data.homepage!.name}
                width="190" height="60" loading="lazy" />
            </a>
            <h3><a href={data.orgUrl}>{data.homepage!.name}</a></h3>
            {data.homepage!.department && <p class="affiliation__department">{data.homepage!.department}</p>}
            <p class="affiliation__role">{data.homepage!.position}</p>
            <small>{data.homepage!.period}</small>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>
<style>
  .affiliations__inner {
    border-block: 1px solid var(--border);
    padding-block: var(--space-5);
  }
  .affiliations__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-5);
  }
  h2 { font-size: var(--text-base); font-weight: 600; }
  .affiliations__heading a { font-size: var(--text-xs); }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-5);
    row-gap: var(--space-2);
    list-style: none;
    padding: 0;
  }
  .affiliation {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    min-width: 0;
    align-items: start;
  }
  .affiliation-logo {
    grid-row: 1;
    display: flex;
    align-items: center;
    height: 68px;
    width: 100%;
    max-width: 190px;
    margin-bottom: var(--space-2);
  }
  img { width: 100%; height: 60px; object-fit: contain; object-position: left center; }
  .affiliation--ctu-vrg img { width: 100px; }
  .affiliation--porsche img { width: 100px; }
  h3 { grid-row: 2; font-size: var(--text-sm); line-height: var(--leading-snug); }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .affiliation__department { grid-row: 3; font-size: var(--text-xs); color: var(--text-muted); }
  .affiliation__role { grid-row: 4; font-size: var(--text-sm); line-height: 1.5; color: var(--text); }
  small { grid-row: 5; display: block; font-size: var(--text-xs); color: var(--text-subtle); }
  /* The marks retain their transparent backgrounds in both themes.
     Lighten the coloured wordmarks without adding a panel behind them. */
  :global(:root[data-theme='dark']) .affiliation--qualcomm img {
    filter: brightness(1.8) saturate(0.8);
  }
  :global(:root[data-theme='dark']) .affiliation--tuebingen img {
    filter: brightness(2.1) saturate(0.7);
  }
  @supports not (grid-template-rows: subgrid) {
    .affiliation { grid-template-rows: 76px auto auto 1fr auto; gap: var(--space-2); }
  }
  @media (max-width: 760px) {
    ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-5); }
    .affiliation:nth-child(n + 3) .affiliation-logo { margin-top: var(--space-5); }
  }
</style>
