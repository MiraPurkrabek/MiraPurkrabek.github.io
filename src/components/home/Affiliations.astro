---
import { getCollection } from 'astro:content';
import Container from '../Container.astro';
const experience = await getCollection('experience');
const affiliations = [
  {
    id: 'ctu-vrg',
    name: 'CTU Prague',
    role: 'Research & PhD · Visual Recognition Group',
    period: 'Research since 2019 · PhD since 2023',
  },
  {
    id: 'porsche',
    name: 'Porsche Engineering',
    role: 'Software development · EVs & charging',
    period: '2020–2022',
  },
  {
    id: 'tuebingen',
    name: 'University of Tübingen',
    role: 'Research visit · Real Virtual Humans',
    period: '2025–2026',
  },
  {
    id: 'qualcomm',
    name: 'Qualcomm',
    role: 'Research internship · XR Labs, Amsterdam',
    period: '2026',
  },
].map((item) => ({
  ...item,
  data: experience.find((entry) => entry.id === item.id)!.data,
}));
---

<section
  aria-label="Research and engineering affiliations"
  class="affiliations"
>
  <Container size="page">
    <div class="affiliations__inner">
      <div class="affiliations__heading">
        <h2>Along the way</h2><a href="/cv/#experience"
          >Experience &amp; education</a>
      </div>
      <ul>
        {
          affiliations.map((item) => (
            <li>
              <a
                class="affiliation-logo"
                href={item.data.orgUrl}
                aria-label={item.name}
              >
                <img
                  src={item.data.logo}
                  alt={item.name}
                  width="190"
                  height="44"
                  loading="lazy"
                />
              </a>
              <p>{item.role}</p>
              <small>{item.period}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
<style>
  .affiliations__inner {
    border-block: 1px solid var(--border);
    padding-block: 1rem 1.25rem;
  }
  .affiliations__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.1rem;
  }
  h2 {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .affiliations__heading a {
    font-size: 0.875rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }
  .affiliation-logo {
    display: flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    height: 52px;
    margin-bottom: 0.7rem;
  }
  img {
    width: 190px;
    max-width: 100%;
    height: 44px;
    object-fit: contain;
    object-position: left center;
  }
  p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  small {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--text-subtle);
  }
  :global(:root[data-theme='dark']) .affiliation-logo {
    background: #fff;
    border-radius: 4px;
    padding: 8px;
  }
  @media (max-width: 760px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1.5rem;
    }
  }
</style>
