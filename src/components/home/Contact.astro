---
import Section from '../Section.astro';
import { site } from '../../data/site';
---

<Section id="contact">
  <div class="contact">
    <div>
      <h2>Get in touch</h2><p>
        I'm open to applied scientist and research engineer roles in computer
        vision, and selected consulting work. If you have a project or a
        question in mind, I'd be happy to hear from you.
      </p>
    </div>
    <a href={`mailto:${site.email.primary}`}>{site.email.primary}</a>
  </div>
</Section>
<style>
  .contact {
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 2rem;
  }
  h2 {
    font-size: 1.125rem;
    margin-bottom: 0.6rem;
  }
  p {
    max-width: 65ch;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .contact > a {
    font-size: 0.9375rem;
    white-space: nowrap;
    padding-top: 0.25rem;
  }
  @media (max-width: 700px) {
    .contact {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
