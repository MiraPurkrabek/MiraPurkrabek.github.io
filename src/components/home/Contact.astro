---
// Homepage contact — see
// docs/redesign_15-08-2026_PRs/PR-06-home-recognition-contact.md §4.
//
// The lede sentence is built around `site.availability.text` (not hardcoded) so it stays in
// sync with the hero pill, per the PR's explicit instruction — only the surrounding sentence
// structure and the fixed consulting clause are static.
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import { site } from '../../data/site';

const availability =
  site.availability.text.charAt(0).toLowerCase() +
  site.availability.text.slice(1);
const lede = `I'm finishing my PhD and ${availability} in computer vision. I'm also open to selected consulting work.`;
---

<Section id="contact" tone="soft">
  <div class="contact">
    <SectionHeading heading="Interested in working together?" lead={lede} />

    <div class="contact__actions">
      <div class="contact__email-group">
        <Button
          href={`mailto:${site.email.primary}`}
          variant="primary"
          icon="mail"
          iconPosition="leading"
        >
          Email me
        </Button>
        <p class="contact__email-address">{site.email.primary}</p>
      </div>

      <Button
        href={site.cvPath}
        target="_blank"
        variant="secondary"
        icon="download"
      >
        CV (PDF)
      </Button>
      <Button
        href={site.social.linkedin}
        target="_blank"
        variant="secondary"
        icon="arrow-up-right"
      >
        LinkedIn
      </Button>
      <Button
        href={site.social.github}
        target="_blank"
        variant="secondary"
        icon="arrow-up-right"
      >
        GitHub
      </Button>
      <Button
        href={site.social.googleScholar}
        target="_blank"
        variant="secondary"
        icon="arrow-up-right"
      >
        Google Scholar
      </Button>
    </div>
  </div>
</Section>

<style>
  .contact {
    text-align: center;
  }

  .contact :global(.section-heading) {
    justify-content: center;
    text-align: center;
  }

  .contact :global(.section-heading__text) {
    max-width: var(--width-text);
    margin-inline: auto;
  }

  .contact :global(.section-heading__lead) {
    margin-inline: auto;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .contact__email-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .contact__email-address {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
</style>
