---
import { news } from '../../data/news';
const recent = news.slice(0, 4);
---

<aside aria-labelledby="updates-heading">
  <h2 id="updates-heading">Lately</h2>
  <ol>
    {
      recent.map((item) => (
        <li>
          <>
            <time datetime={item.date}>{item.label}</time>
            <p set:html={item.shortHtml ?? item.html} />
          </>
        </li>
      ))
    }
  </ol>
  <a class="archive-link" href="/news/">More updates</a>
  <div class="small-note">
    <h3>Teaching</h3><p>
      I teach pattern recognition and machine learning at CTU and supervise
      student research.
    </p><a href="/about/#teaching">For students</a>
  </div>
</aside>
<style>
  h2 {
    font-size: 1.375rem;
    margin-bottom: 1.5rem;
  }
  ol {
    list-style: none;
    padding: 0;
  }
  li {
    margin-bottom: 1.3rem;
  }
  time {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 0.35rem;
  }
  p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  aside :global(a) {
    text-decoration: none;
  }
  aside :global(a:hover) {
    text-decoration: underline;
  }
  .archive-link,
  .small-note > a {
    font-size: 0.875rem;
  }
  .small-note {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .small-note p {
    margin-bottom: 0.6rem;
  }
</style>
