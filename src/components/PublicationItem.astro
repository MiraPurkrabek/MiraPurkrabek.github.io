---
// Single row on /publications — see docs/redesign_15-08-2026_PRs/PR-08-publications-page.md.
// Author list keeps Miroslav's name in the exact printed form (never "Mira" — this page stays
// in the official register). Abstract/BibTeX are native <details>/<summary> disclosures so they
// work with JavaScript disabled; only the BibTeX copy button needs the script below.
import { Image } from 'astro:assets';
import { type CollectionEntry } from 'astro:content';
import Button from './Button.astro';
import Tag from './Tag.astro';
import Prose from './Prose.astro';
import Icon from './Icon.astro';

export interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;

const linkOrder = [
  ['project', 'Project'],
  ['paper', 'Paper'],
  ['arxiv', 'arXiv'],
  ['code', 'Code'],
  ['demo', 'Demo'],
  ['models', 'Models'],
  ['dataset', 'Dataset'],
] as const;

const links = linkOrder.flatMap(([key, label]) => {
  const href = data.links?.[key];
  return href ? [{ href, label }] : [];
});
const primaryHref = links[0]?.href;
---

<article class="pub-item">
  <div class="pub-item__media">
    <Image
      src={data.thumbnail.src}
      alt={data.thumbnail.alt}
      width={160}
      format="jpg"
      loading="lazy"
      decoding="async"
      class="pub-item__image"
    />
  </div>

  <div class="pub-item__body">
    <h3 class="pub-item__title">
      {
        primaryHref ? (
          <a href={primaryHref} target="_blank" rel="noopener">
            {data.title}
            <Icon name="arrow-up-right" size={18} />
          </a>
        ) : (
          data.title
        )
      }
    </h3>

    <p class="pub-item__authors">
      {
        data.authors.map((author, index) => (
          <>
            {index > 0 && ', '}
            {author === 'Miroslav Purkrábek' ? (
              <strong class="pub-item__author--self">{author}</strong>
            ) : (
              author
            )}
          </>
        ))
      }
    </p>

    <p class="pub-item__meta">
      <span>{data.venue}</span>
      {data.role === 'supervised' && <Tag>Supervised student work</Tag>}
    </p>

    {
      data.awards.length > 0 && (
        <p class="pub-item__award">★ {data.awards.join(', ')}</p>
      )
    }

    <p class="pub-item__summary">{data.summary}</p>

    <div class="pub-item__links">
      {
        links.map((link) => (
          <Button
            href={link.href}
            variant="secondary"
            size="sm"
            icon="arrow-up-right"
            target="_blank"
          >
            {link.label}
          </Button>
        ))
      }

      <details class="pub-item__disclosure">
        <summary>Abstract</summary>
        <div class="pub-item__disclosure-body">
          <Prose>
            <p>{data.abstract}</p>
          </Prose>
        </div>
      </details>

      {
        data.bibtex && (
          <details class="pub-item__disclosure pub-item__bibtex">
            <summary>BibTeX</summary>
            <div class="pub-item__disclosure-body">
              <div class="pub-item__bibtex-controls">
                <button type="button" class="pub-item__copy" data-copy-bibtex>
                  Copy
                </button>
                <span
                  class="visually-hidden"
                  role="status"
                  aria-live="polite"
                  data-copy-status
                />
              </div>
              {/* prettier-ignore */}
              <pre tabindex="0"><code>{data.bibtex}</code></pre>
            </div>
          </details>
        )
      }
    </div>
  </div>
</article>

<style>
  .pub-item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--border);
  }

  .pub-item__media {
    flex: 0 0 160px;
    width: 160px;
    height: 110px;
    box-sizing: border-box;
    padding: var(--space-2);
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      width var(--dur) var(--ease),
      height var(--dur) var(--ease),
      padding var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .pub-item__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pub-item__body {
    flex: 1 1 320px;
    min-width: 0;
  }

  .pub-item__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .pub-item__title a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--text);
    text-decoration: none;
  }

  .pub-item__title a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .pub-item__title :global(svg) {
    flex: 0 0 auto;
  }

  .pub-item__authors {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pub-item__author--self {
    color: var(--accent);
    font-weight: 600;
  }

  .pub-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
  }

  .pub-item__award {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .pub-item__summary {
    max-width: var(--width-text);
    margin-top: var(--space-4);
    color: var(--text-muted);
    line-height: var(--leading-snug);
  }

  .pub-item__links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
  }

  .pub-item__disclosure summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    list-style: none;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .pub-item__disclosure summary::-webkit-details-marker {
    display: none;
  }

  .pub-item__disclosure summary::after {
    content: '▾';
    transition: transform var(--dur) var(--ease);
  }

  .pub-item__disclosure[open] summary::after {
    transform: rotate(-180deg);
  }

  .pub-item__disclosure summary:hover {
    background: var(--surface-hover);
    border-color: var(--text-subtle);
  }

  .pub-item__disclosure[open] {
    flex: 1 1 100%;
  }

  .pub-item__disclosure-body {
    margin-top: var(--space-4);
  }

  .pub-item__bibtex-controls {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-2);
  }

  .pub-item__copy {
    padding: var(--space-1) var(--space-3);
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .pub-item__copy:hover {
    background: var(--surface-hover);
  }

  .pub-item__bibtex pre {
    margin: 0;
    padding: var(--space-4);
    background: var(--surface-soft);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  @media (max-width: 480px) {
    .pub-item__media {
      width: 0;
      height: 0;
      padding: 0;
      border-width: 0;
    }
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>('[data-copy-bibtex]');
    if (!button) return;

    const pre = button.closest('.pub-item__bibtex')?.querySelector('pre');
    const text = pre?.textContent?.trim() ?? '';
    const status = button.parentElement?.querySelector('[data-copy-status]');

    navigator.clipboard.writeText(text).then(() => {
      button.textContent = 'Copied';
      if (status) status.textContent = 'BibTeX copied to clipboard';
      window.setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 1500);
    });
  });
</script>
