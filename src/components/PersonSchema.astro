---
// schema.org/Person JSON-LD, rendered on the homepage only. The official and casual name forms
// are both present to support entity resolution across academic and professional profiles.
import { site } from '../data/site';
import { getCollection } from 'astro:content';
const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);

export interface Props {
  description: string;
}

const { description } = Astro.props;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.siteUrl}/#person`,
  name: site.name,
  alternateName: [site.legalName, 'Miroslav Purkrabek'],
  url: site.siteUrl,
  image: new URL(site.ogImage, site.siteUrl).toString(),
  email: `mailto:${site.email.primary}`,
  jobTitle: 'Computer Vision Researcher',
  description,
  affiliation: {
    '@type': 'Organization',
    name: 'Visual Recognition Group, Czech Technical University in Prague',
    url: 'https://vrg.fel.cvut.cz/',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Qualcomm',
    url: 'https://www.qualcomm.com/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Czech Technical University in Prague',
    url: 'https://fel.cvut.cz/en',
  },
  subjectOf: ['/about/', '/work/', '/publications/', '/coaching/'].map((path) => ({
    '@type': 'WebPage', url: new URL(path, site.siteUrl).toString(),
  })),
  hasCredential: education.filter(({ data }) => !data.degree.includes('in progress')).map(({ data }) => ({
    '@type': 'EducationalOccupationalCredential',
    name: `${data.degree} · ${data.field}`,
    credentialCategory: data.degree,
    recognizedBy: { '@type': 'CollegeOrUniversity', name: data.institution },
  })),
  knowsAbout: [
    'Human pose estimation',
    'Computer vision',
    'Machine learning',
    '3D reconstruction',
    'Video analysis',
    'Robust perception',
    'Spatial reasoning',
    'Human body shape estimation',
    'Vision-language models',
    'Personal AI',
    'Python',
    'C / C++',
    'PyTorch',
    'OpenCV',
    'SLURM',
    'Git',
    'SMPL',
    'CUDA',
    'Blender',
    'MMCV',
    'Teaching and research supervision',
    'Floorball coaching',
  ],
  sameAs: [
    site.social.github,
    site.social.googleScholar,
    site.social.orcid,
    site.social.linkedin,
  ],
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(person)}
/>
