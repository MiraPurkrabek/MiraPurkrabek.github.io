---
import Icon from './Icon.astro';

export interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  seeAll?: { href: string; label: string };
  class?: string;
}

const { eyebrow, heading, lead, seeAll, class: className } = Astro.props;
---

<div class:list={['section-heading', className]}>
  <div class="section-heading__text">
    {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
    <h2 class="section-heading__title">{heading}</h2>
    {lead && <p class="section-heading__lead">{lead}</p>}
  </div>
  {
    seeAll && (
      <a class="section-heading__see-all" href={seeAll.href}>
        {seeAll.label}
        <Icon name="arrow-right" size={16} />
      </a>
    )
  }
</div>

<style>
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .section-heading__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-subtle);
    margin-bottom: var(--space-2);
  }

  .section-heading__title {
    font-size: var(--text-2xl);
  }

  .section-heading__lead {
    margin-top: var(--space-3);
    max-width: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .section-heading__see-all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .section-heading__see-all:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 640px) {
    .section-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
