---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectEntry from '../components/ProjectEntry.astro';

const projects = await getCollection('projects');

const groups = [
  {
    id: 'research',
    heading: 'Research',
    kind: 'research' as const,
    tone: 'soft' as const,
  },
  {
    id: 'applied-systems',
    heading: 'Applied systems',
    kind: 'applied' as const,
    tone: 'default' as const,
  },
  {
    id: 'tools',
    heading: 'Tools & open source',
    kind: 'tool' as const,
    tone: 'soft' as const,
  },
].map((group) => ({
  ...group,
  entries: projects
    .filter((project) => project.data.kind === group.kind)
    .sort((a, b) => a.data.order - b.data.order),
}));

const title = 'Work — Mira Purkrábek';
const description =
  'Research on robust human perception, and the systems that put it to use — computer vision papers, code and applied deployments from crowded scenes to production camera systems.';
---

<BaseLayout title={title} description={description}>
  <Section>
    <h1 class="work-hero__title">Work</h1>
    <p class="work-hero__lead">
      Research on robust human perception, and the systems that put it to use.
      Papers link to their project pages; systems link to code or a write-up
      where it exists.
    </p>
  </Section>

  {
    groups.map((group) => (
      <Section id={group.id} tone={group.tone}>
        <h2 class="work-group__heading">{group.heading}</h2>
        <div class="work-group__list">
          {group.entries.map((entry) => (
            <ProjectEntry project={entry} />
          ))}
        </div>
      </Section>
    ))
  }

  <Section size="text">
    <p class="work-closing">
      Publications with abstracts and BibTeX → <a href="/publications"
        >/publications</a
      >
    </p>
  </Section>
</BaseLayout>

<style>
  .work-hero__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .work-hero__lead {
    max-width: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .work-group__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-7);
  }

  .work-group__list {
    display: grid;
    gap: var(--space-6);
  }

  .work-closing {
    text-align: center;
    color: var(--text-muted);
  }
</style>
