---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
const education = (await getCollection('education')).sort(
  (a, b) => a.data.order - b.data.order,
);
const recognition = (await getCollection('recognition')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<BaseLayout
  title="Full CV — Miroslav Purkrábek"
  description="Miroslav Purkrábek's experience, education, technical skills, awards, research contributions and teaching. Computer vision and machine learning researcher and engineer."
>
  <Section size="text">
    <header class="cv-header">
      <h1>Miroslav Purkrábek</h1><p>
        Computer vision &amp; machine learning researcher
      </p><div class="downloads">
        <a href={site.cvPath}>Download two-page CV</a><a href="/CV.pdf"
          >Alternative CV (PDF)</a
        ><a href={`mailto:${site.email.primary}`}>Email</a>
      </div>
    </header>
    <nav class="contents" aria-label="CV sections">
      <a href="#experience">Experience</a><a href="#skills">Skills</a><a
        href="#education">Education</a
      ><a href="#recognition">Awards &amp; service</a><a href="#research"
        >Research</a
      >
    </nav>
    <section id="experience">
      <h2>Experience</h2><ol class="entries">
        {
          experience.map(({ data }) => (
            <li>
              <h3>
                {data.orgUrl ? <a href={data.orgUrl}>{data.org}</a> : data.org}
              </h3>
              <p class="role">{data.role}</p>
              <p class="meta">
                {data.displayPeriod} · {data.location}
              </p>
              <p>{data.summary}</p>
              {data.details && (
                <ul>
                  {data.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              )}
              {data.kind === 'leadership' && (
                <p>
                  <a href="/coaching/">
                    Seasons, results and coaching background
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>
    <section id="skills">
      <h2>Technical skills</h2>
      <dl>
        <dt>Python</dt><dd>
          Research implementations and deep learning; training models such as
          PMPose-h for more than ten days on eight GPUs using SLURM; automated
          daily testing at Porsche.
        </dd><dt>C / C++</dt><dd>
          Production automotive control-unit code, Plug &amp; Charge for
          Porsche's charger, and an autonomous robot in a university course.
        </dd><dt>Frameworks &amp; tools</dt><dd>
          PyTorch, OpenCV, SLURM, Git, SMPL, CUDA, Blender and MMCV.
        </dd><dt>Research focus</dt><dd>
          Human 2D and 3D pose, robustness, UV maps, 3D scene understanding,
          person detection and segmentation; shape estimation and tracking.
        </dd>
      </dl>
    </section>
    <section id="education">
      <h2>Education</h2><ol class="entries">
        {
          education.map(({ data }) => (
            <li>
              <h3>
                {data.degree} · {data.field}
              </h3>
              <p class="meta">{data.period}</p>
              <p>{data.institution}</p>
              {data.note && <p>{data.note}</p>}
              {data.thesisLink && <a href={data.thesisLink}>Thesis</a>}
            </li>
          ))
        }
      </ol>
    </section>
    <section id="recognition">
      <h2>Awards, talks &amp; service</h2><ul class="recognition">
        {
          recognition.map(({ data }) => (
            <li>
              <>
                <span class="meta">{data.year}</span>
                <div>
                  <p>
                    {data.link ? (
                      <a href={data.link}>{data.title}</a>
                    ) : (
                      data.title
                    )}{' '}
                    · {data.org}
                  </p>
                  {data.description && <p class="detail">{data.description}</p>}
                </div>
              </>
            </li>
          ))
        }
      </ul>
    </section>
    <section id="research">
      <h2>Research contributions</h2><p>
        I enjoy connecting basic research with real-world applications. My
        publications include:
      </p>
      <ul class="research">
        <li>
          <a href="/publications/#bmpv2">BBoxMaskPose v2</a> (preprint / in review):
          2D predictions as prompts for 3D reconstruction, and the first method to
          exceed 50 AP on OCHuman. Includes PMPose and the OCHuman-Pose dataset.
        </li>
        <li>
          <a href="/publications/#bbox-mask-pose">BBox-Mask-Pose</a> (ICCV 2025):
          detection, pose and segmentation in a feedback loop. The CV reports an AP
          comparison of 41.3 to 49.2 against human-centric foundation models.
        </li>
        <li>
          <a href="/publications/#probpose">ProbPose</a> (CVPR 2025): probabilistic
          pose estimation, including out-of-image keypoints, calibrated presence probabilities,
          CropCOCO and Extended OKS. <a href="/webcam_demo/"
            >Live iPad poster demo</a
          >.
        </li>
        <li>
          <a href="/publications/#blanket">BLANKET</a> (ICDL 2025, oral): infant face
          anonymization while preserving facial attributes and pose-estimation consistency.
        </li>
        <li>
          <a href="/publications/#repogen">RePoGen</a> (FG 2024, Best Poster Award):
          synthetic data for rare viewpoints in human pose estimation.
        </li>
      </ul>
      <p>
        <a href="/publications/"
          >All nine publications and theses, including supervised work,
          abstracts and BibTeX</a
        >.
      </p>
      <details>
        <summary>Open-source uptake recorded in the two-page CV</summary><p>
          BBoxMaskPose / BMPv2: 200+ GitHub stars; ProbPose: 50+ GitHub stars
          and 350+ downloads of the <a
            href="https://pypi.org/project/exococotools/"
            >exococotools evaluation package</a
          >; RePoGen: 50+ GitHub stars. These are the CV's recorded figures,
          rather than live counters.
        </p>
      </details>
    </section>
    <section id="teaching">
      <h2>Teaching &amp; supervision</h2><p>
        Pattern Recognition and Machine Learning (RPZ), CTU Prague.
        Co-supervision of SAM-pose2seg (CVWW 2026, Best Student Paper) and
        PC-CSE (CVWW 2025); support for junior colleagues writing their first
        papers; coordination of annotation work.
      </p><p><a href="/about/#teaching">Course and student information</a>.</p>
    </section>
    <section id="elsewhere">
      <h2>Elsewhere</h2><p>
        Floorball coaching at SKV, including the Czech Superliga; coaching and
        refereeing in Ljubljana; a Czech coaching B licence. Mountains, travel,
        psychology and epic fantasy. <a href="/about/">More about me</a>.
      </p>
    </section>
  </Section>
</BaseLayout>
<style>
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: 0.5rem;
  }
  .cv-header > p {
    color: var(--text-muted);
    font-size: 1.125rem;
  }
  .downloads,
  .contents {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }
  .downloads {
    margin-top: 1rem;
  }
  .contents {
    padding-block: 1rem;
    margin-block: 1.5rem 2rem;
    border-block: 1px solid var(--border);
  }
  section section {
    margin-top: 2.5rem;
  }
  h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.35rem;
  }
  .entries {
    list-style: none;
    padding: 0;
  }
  .entries > li {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }
  .entries p,
  dd,
  .research li {
    color: var(--text-muted);
  }
  .entries p.role {
    color: var(--text);
    margin-bottom: 0.35rem;
  }
  p.meta,
  .meta {
    font-size: 0.8125rem;
    color: var(--text-subtle);
    margin-bottom: 0.4rem;
  }
  .entries ul {
    padding-left: 1.15rem;
    margin-top: 0.5rem;
    color: var(--text-muted);
  }
  dt {
    font-weight: 600;
    margin-top: 1rem;
  }
  dd {
    margin-top: 0.25rem;
  }
  .recognition {
    list-style: none;
    padding: 0;
  }
  .recognition li {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .detail {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .research {
    padding-left: 1.15rem;
    margin-block: 1rem;
  }
  .research li + li {
    margin-top: 0.75rem;
  }
  details {
    margin-top: 1rem;
    color: var(--text-muted);
  }
  summary {
    cursor: pointer;
    color: var(--accent);
    padding-block: 0.5rem;
  }
</style>
