---
// /publications — full publication list. See
// docs/redesign_15-08-2026_PRs/PR-08-publications-page.md.
//
// Grouped by year (newest first), theses in their own group at the end so they never dilute the
// peer-reviewed list. Within a year, first-author work leads, then co-author, then supervised
// work — this reproduces the order the fact sheet already lists them in
// (PR-00-OVERVIEW.md §8 "Publications").
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { site } from '../data/site';

const publications = await getCollection('publications');
const recognition = await getCollection('recognition');
const awards = recognition
  .filter((entry) => ['award', 'competition'].includes(entry.data.kind))
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
const service = recognition
  .filter((entry) => entry.data.kind === 'service')
  .sort((a, b) => a.data.order - b.data.order);

const roleOrder = { 'first-author': 0, 'co-author': 1, supervised: 2 } as const;

const theses = publications
  .filter((entry) => entry.data.type === 'thesis')
  .sort((a, b) => b.data.year - a.data.year);

const years = [
  ...new Set(
    publications
      .filter((entry) => entry.data.type !== 'thesis')
      .map((entry) => entry.data.year),
  ),
].sort((a, b) => b - a);

const groups = [
  ...years.map((year) => ({
    heading: String(year),
    entries: publications
      .filter(
        (entry) => entry.data.type !== 'thesis' && entry.data.year === year,
      )
      .sort((a, b) => roleOrder[a.data.role] - roleOrder[b.data.role]),
  })),
  { heading: 'Theses', entries: theses },
];

// Title/description per PR-11 §1 "Page titles and descriptions" table — use verbatim.
const title = 'Publications & recognition — Mira Purkrábek';
const description =
  'Computer vision publications, awards and competition results, including first-author CVPR and ICCV papers and Outstanding Reviewer at CVPR 2025.';
---

<BaseLayout title={title} description={description}>
  <Section>
    <h1 class="pub-hero__title">Publications &amp; recognition</h1>
    <p class="pub-hero__lead">
      Papers and challenge results on human analysis, 3D reconstruction and
      scene understanding. Publications are also on <a
        href={site.social.googleScholar}
        target="_blank"
        rel="noopener">Google Scholar ↗</a
      > and <a href={site.social.orcid} target="_blank" rel="noopener"
        >ORCID ↗</a
      >.
    </p>
    <nav class="pub-jump-links" aria-label="On this page">
      <a href="#papers">Papers, challenges &amp; theses</a>
      <a href="#recognition">Awards &amp; competitions</a>
      <a href="#service">Reviewing &amp; service</a>
    </nav>
  </Section>

  <Section id="papers">
    {
      groups.map((group) => (
        <div class="pub-group">
          <h2 class="pub-group__heading">{group.heading}</h2>
          <ul class="pub-group__list">
            {group.entries.map((entry) => (
              <li>
                <PublicationItem publication={entry} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </Section>

  <Section id="recognition" tone="soft">
    <h2 class="pub-section-heading">Awards &amp; competitions</h2>
    <ul class="recognition-list">
      {awards.map(({ id, data }) => (
        <li id={id} class="recognition-row">
          <span class="recognition-year">{data.year}</span>
          <div>
            <h3>{data.link ? <a href={data.link}>{data.title}</a> : data.title}</h3>
            <p>{data.org}</p>
            {data.description && <p class="recognition-detail">{data.description}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="service">
    <h2 class="pub-section-heading">Reviewing &amp; service</h2>
    <ul class="recognition-list">
      {service.map(({ id, data }) => (
        <li id={id} class="recognition-row">
          <span class="recognition-year">{id === 'peer-review-service' ? 'Ongoing' : data.year}</span>
          <div>
            <h3>{data.link ? <a href={data.link}>{data.title}</a> : data.title}</h3>
            <p>{data.org}</p>
            {data.description && <p class="recognition-detail">{data.description}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section size="text">
    <p class="pub-closing">
      <a href="/work/">Projects and systems behind these papers</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .pub-hero__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .pub-hero__lead {
    max-width: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .pub-group + .pub-group {
    margin-top: var(--space-9);
  }

  .pub-group__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .pub-group__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .pub-group__list li:last-child :global(.pub-item) {
    border-bottom: none;
  }

  .pub-closing {
    text-align: center;
    color: var(--text-muted);
  }

  .pub-jump-links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); margin-top: var(--space-5); font-size: var(--text-sm); }
  .pub-section-heading { font-size: var(--text-2xl); margin-bottom: var(--space-5); }
  .recognition-list { list-style: none; padding: 0; border-top: 1px solid var(--border); }
  .recognition-row { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-4); border-bottom: 1px solid var(--border); }
  .recognition-year { font-size: var(--text-xs); color: var(--text-subtle); padding-top: var(--space-1); }
  .recognition-row h3 { font-size: var(--text-base); line-height: var(--leading-body); }
  .recognition-row h3 a { color: var(--text); }
  .recognition-row h3 a:hover { color: var(--accent); }
  .recognition-row p { color: var(--text-muted); font-size: var(--text-sm); }
  .recognition-detail { margin-top: var(--space-1); }
  @media (max-width: 480px) { .recognition-row { grid-template-columns: 3.75rem minmax(0, 1fr); gap: var(--space-3); } }
</style>
