---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/PersonSchema.astro';
import Hero from '../components/home/Hero.astro';
import Affiliations from '../components/home/Affiliations.astro';
import Impact from '../components/home/Impact.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Timeline from '../components/home/Timeline.astro';
import Recognition from '../components/home/Recognition.astro';
import SelectedPublications from '../components/home/SelectedPublications.astro';
import Beyond from '../components/home/Beyond.astro';
import Contact from '../components/home/Contact.astro';

// Title/description per docs/redesign_15-08-2026_PRs/PR-11-seo-metadata-redirects.md §1
// "Page titles and descriptions" table — use verbatim, don't reword.
const title = 'Mira Purkrábek — Computer vision researcher and engineer';
const description =
  'Applied computer vision: first-author CVPR/ICCV research on robust human perception, plus systems in production. PhD candidate at CTU Prague, research intern at Qualcomm.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <PersonSchema description={description} />
  </Fragment>
  <Hero />
  <Affiliations />
  <Impact />
  <SelectedWork />
  <Timeline />
  <Recognition />
  <SelectedPublications />
  <Beyond />
  <Contact />
</BaseLayout>
