---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Affiliations from '../components/home/Affiliations.astro';
import Impact from '../components/home/Impact.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Timeline from '../components/home/Timeline.astro';
import Recognition from '../components/home/Recognition.astro';
import SelectedPublications from '../components/home/SelectedPublications.astro';
import Beyond from '../components/home/Beyond.astro';
import Contact from '../components/home/Contact.astro';

// Final, authoritative <title>/description are wired in PR-11; this is the interim value drawn
// from the hero paragraph per PR-04 §4.
const title = 'Mira Purkrábek — Computer vision researcher and engineer';
const description =
  'I build visual perception that survives contact with reality — crowded scenes, cropped bodies, unusual viewpoints. First-author papers at CVPR and ICCV, code and models people actually run, and systems that went into production.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <Affiliations />
  <Impact />
  <SelectedWork />
  <Timeline />
  <Recognition />
  <SelectedPublications />
  <Beyond />
  <Contact />
</BaseLayout>
