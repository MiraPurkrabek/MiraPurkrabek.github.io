---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/PersonSchema.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Beyond from '../components/home/Beyond.astro';
import Contact from '../components/home/Contact.astro';
import Updates from '../components/home/Updates.astro';
import Container from '../components/Container.astro';
const title = 'Mira Purkrábek — Computer vision researcher and engineer';
const description =
  'Miroslav (Mira) Purkrábek: computer vision researcher and engineer, PhD at CTU Prague, Qualcomm XR Labs intern. First-author CVPR and ICCV research, deployed systems, and eight years coaching floorball.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head"><PersonSchema description={description} /></Fragment>
  <Hero />
  <Container size="page">
    <div class="home-columns"><SelectedWork /><Updates /></div>
  </Container>
  <Beyond />
  <Contact />
</BaseLayout>
<style>
  .home-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 245px;
    gap: 3rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 800px) {
    .home-columns {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
