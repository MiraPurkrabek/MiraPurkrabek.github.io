---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonSchema from '../components/PersonSchema.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Beyond from '../components/home/Beyond.astro';
import Contact from '../components/home/Contact.astro';
import Affiliations from '../components/home/Affiliations.astro';
import Container from '../components/Container.astro';
const title = 'Mira Purkrábek — Computer vision researcher and engineer';
const description =
  'Miroslav (Mira) Purkrábek: computer vision researcher and engineer, PhD at CTU Prague, Qualcomm XR Labs intern. First-author CVPR and ICCV research, deployed systems, and eight years coaching floorball.';
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head"><PersonSchema description={description} /></Fragment>
  <Hero />
  <Affiliations />
  <Container size="page">
    <div class="home-work"><SelectedWork /></div>
  </Container>
  <Beyond />
  <Contact />
</BaseLayout>
<style>
  .home-work {
    padding-block: 1.75rem 0.25rem;
  }
</style>
